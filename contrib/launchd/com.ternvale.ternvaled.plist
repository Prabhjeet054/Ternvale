<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ternvale.ternvaled</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/ternvaled</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/ternvaled.out.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/ternvaled.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TERNVALE_LOG</key>
		<string>info</string>
	</dict>
</dict>
</plist>
