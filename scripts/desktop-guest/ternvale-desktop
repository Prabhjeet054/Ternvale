#!/bin/sh
# Starts the desktop: Xorg on the virtio-gpu (modesetting on /dev/dri/card0, or fbdev
# on /dev/fb0 with `ternvale.xdriver=fbdev`), the virtio-input keyboard and tablet
# through the evdev input driver, twm, and one xterm titled "ternvale-xterm" at
# +100+100. Reports on the serial console:
#   ternvale desktop ready driver=<d> screen=<w>x<h> keyboard=<dev> tablet=<dev>
#   ternvale desktop failed: <why>        (then dumps the tail of the Xorg log)
# No udev runs in this guest, so input devices are listed in xorg.conf by node,
# found by their virtio-input names in sysfs.
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin HOME=/root DISPLAY=:0
serial=/dev/ttyAMA0
say() { echo "ternvale desktop $*" >"${serial}"; }
fail() {
  say "failed: $*"
  tail -n 25 /var/log/Xorg.0.log 2>/dev/null | sed 's/^/xorg: /' >"${serial}"
  exit 1
}

kbd=""
tab=""
for d in /sys/class/input/event*; do
  case "$(cat "${d}/device/name" 2>/dev/null)" in
    *"Virtio Keyboard"*) kbd="/dev/input/${d##*/}" ;;
    *"Virtio Tablet"*) tab="/dev/input/${d##*/}" ;;
  esac
done
[ -n "${kbd}" ] || fail "no virtio-input keyboard in /sys/class/input"
[ -n "${tab}" ] || fail "no virtio-input tablet in /sys/class/input"

driver=modesetting
swcursor=true
for arg in $(cat /proc/cmdline); do
  case "${arg}" in
    ternvale.xdriver=*) driver="${arg#ternvale.xdriver=}" ;;
    ternvale.hwcursor) swcursor=false ;;
  esac
done
case "${driver}" in
  modesetting)
    # The device model ignores the cursor queue (no hardware cursor yet), so X
    # must draw the pointer into the framebuffer itself; `ternvale.hwcursor`
    # turns that off to show the gap.
    device_opts="    Option \"kmsdev\" \"/dev/dri/card0\"
    Option \"SWcursor\" \"${swcursor}\"
    Option \"AccelMethod\" \"none\""
    ;;
  fbdev) device_opts='    Option "fbdev" "/dev/fb0"' ;;
  *) fail "unknown ternvale.xdriver=${driver} (modesetting or fbdev)" ;;
esac

mkdir -p /etc/X11
cat >/etc/X11/xorg.conf <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "false"
    Option "AutoAddGPU" "false"
    Option "BlankTime" "0"
    Option "StandbyTime" "0"
    Option "SuspendTime" "0"
    Option "OffTime" "0"
EndSection
Section "Device"
    Identifier "virtio-gpu"
    Driver "${driver}"
${device_opts}
EndSection
Section "Screen"
    Identifier "screen"
    Device "virtio-gpu"
    DefaultDepth 24
EndSection
Section "InputDevice"
    Identifier "virtio-keyboard"
    Driver "evdev"
    Option "Device" "${kbd}"
EndSection
Section "InputDevice"
    Identifier "virtio-tablet"
    Driver "evdev"
    Option "Device" "${tab}"
EndSection
Section "ServerLayout"
    Identifier "layout"
    Screen "screen"
    InputDevice "virtio-keyboard" "CoreKeyboard"
    InputDevice "virtio-tablet" "CorePointer"
EndSection
EOF

Xorg :0 vt1 -nolisten tcp -noreset -config /etc/X11/xorg.conf -logfile /var/log/Xorg.0.log &
xorg=$!
i=0
until xprop -root >/dev/null 2>&1; do
  kill -0 "${xorg}" 2>/dev/null || fail "Xorg exited"
  i=$((i + 1))
  [ "${i}" -gt 300 ] && fail "Xorg did not answer within 30 s"
  sleep 0.1
done

xsetroot -solid "#2e3440" -cursor_name left_ptr
twm &
xterm -title ternvale-xterm -geometry 80x24+100+100 -bg "#fdf6e3" -fg "#073642" &
i=0
until xdotool search --onlyvisible --name ternvale-xterm >/dev/null 2>&1; do
  i=$((i + 1))
  [ "${i}" -gt 300 ] && fail "the xterm window never mapped"
  sleep 0.1
done
geometry=$(xdotool getdisplaygeometry | tr ' ' x)
say "ready driver=${driver} swcursor=${swcursor} screen=${geometry} keyboard=${kbd} tablet=${tab}"
wait "${xorg}"
say "Xorg exited status=$?"
